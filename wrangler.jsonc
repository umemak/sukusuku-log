{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sukusuku-log",
  "compatibility_date": "2026-09-17",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  // D1: ローカル開発は --local で自動的にSQLiteが作られる。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sukusuku-log-production",
      "database_id": "eeef20c0-b99c-4d92-b5e0-30a52474c2de"
    }
  ]
}
